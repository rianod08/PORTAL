# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.worker-deps/
/worker/__pycache__/
/worker/test-output/
/reference-contact-sheet.jpg
!.env.example
/.local/

# Android machine settings, caches, builds and signing material
**/.gradle/
**/.kotlin/
**/.idea/
**/build/
**/local.properties
*.iml
*.apk
*.aab
*.jks
*.keystore

# Generated capture exports and diagnostic panoramas
/exports/
/public/panoramas/
**/__pycache__/
/supabase/.temp/
